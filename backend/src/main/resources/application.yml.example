spring:
  application:
    name: acusticupc
  datasource:
    url: jdbc:postgresql://CHANGEME-supabase-host:5432/postgres?sslmode=require
    username: postgres.CHANGEME-project-ref
    password: CHANGEME
  jpa:
    hibernate:
      ddl-auto: validate
    open-in-view: false
  flyway:
    enabled: true
    baseline-on-migrate: true
  threads:
    virtual:
      enabled: true
  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 12MB  
      
acusticupc:
  jwt:
    secret: CHANGEME-minimo-32-caracteres-aleatorios
    expiration-ms: 86400000
  bootstrap:
    admin-email: admin@upc.edu.co
    admin-password: CHANGEME

server:
  port: 8080

logging:
  level:
    com.upc.acusticupc: DEBUG
